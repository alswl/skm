{
  "config_dir": "$CFG",
  "targets": [
    {
      "name": "claude-skills",
      "platform": "claude",
      "path": "$HOME/.claude/skills",
      "accepts": ["skill"],
      "strategies": { "skill": "skill-symlink" },
      "builtin": true,
      "valid": true,
      "path_state": "not_writable",
      "error": null,
      "default_path": "$HOME/.claude/skills"
    },
    {
      "name": "claude-commands",
      "platform": "claude",
      "path": "$HOME/.claude/commands",
      "accepts": ["command"],
      "strategies": { "command": "command-marker" },
      "builtin": true,
      "valid": true,
      "path_state": "not_writable",
      "error": null,
      "default_path": "$HOME/.claude/commands"
    },
    {
      "name": "codex",
      "platform": "codex",
      "path": "$HOME/.codex/skills",
      "accepts": ["skill", "command"],
      "strategies": { "skill": "skill-symlink", "command": "command-adapter" },
      "builtin": true,
      "valid": true,
      "path_state": "not_writable",
      "error": null,
      "default_path": "$HOME/.codex/skills"
    },
    {
      "name": "pi",
      "platform": "pi",
      "path": "$HOME/.pi/agent/skills",
      "accepts": ["skill"],
      "strategies": { "skill": "skill-symlink" },
      "builtin": true,
      "valid": true,
      "path_state": "not_writable",
      "error": null,
      "default_path": "$HOME/.pi/agent/skills"
    },
    {
      "name": "dsh",
      "platform": "dsh",
      "path": "$HOME/.dsh/skills",
      "accepts": ["skill"],
      "strategies": { "skill": "skill-symlink" },
      "builtin": true,
      "valid": true,
      "path_state": "not_writable",
      "error": null,
      "name_rule": "kebab-case",
      "default_path": "$HOME/.dsh/skills"
    },
    {
      "name": "agents",
      "platform": "agents",
      "path": "$HOME/.agents/skills",
      "accepts": ["skill"],
      "strategies": { "skill": "skill-symlink" },
      "builtin": true,
      "valid": true,
      "path_state": "not_writable",
      "error": null,
      "name_rule": "kebab-case",
      "default_path": "$HOME/.agents/skills"
    }
  ],
  "invalid": []
}
